{
  "appId": "com.weavai.app",
  "appName": "Weav AI",
  "webDir": "www",
  "ios": {
    "contentInset": "always",
    "scheme": "Weav AI"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1400,
      "launchAutoHide": true,
      "backgroundColor": "#FAF6EE",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#FAF6EE",
      "overlaysWebView": false
    },
    "Camera": {
      "permissions": {
        "camera": "Used by the PhotoFit body scanner to estimate your measurements from a selfie.",
        "photos": "Used to import an existing full-body photo for the PhotoFit body scanner."
      }
    }
  },
  "server": {
    "iosScheme": "weavai",
    "androidScheme": "https"
  }
}
